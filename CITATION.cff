        given-names: Josh
    repository-code: "https://github.com/hadro/directory-pipeline"
  - type: catalogue
    title: "The Green Book collection, Schomburg Center for Research in Black Culture"
    authors:
      - name: "The New York Public Library"
    url: "https://digitalcollections.nypl.org/collections/the-green-book"
  - type: book
    title: "The Negro Motorist Green Book (1946)"
    authors:
